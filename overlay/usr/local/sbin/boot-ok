#!/bin/bash
# Runs once, as the last thing in the boot of the test image. Prints facts about the system and
# powers the machine off.
#
# The facts go to the console (for people reading the log) and to the second serial port, /dev/ttyS1,
# which boot-test.sh captures in a file of its own. The console is shared with the kernel and with
# journald, and under KVM their writes can cut a line in two; nothing else writes to ttyS1.
report=/dev/ttyS1
say() {
  echo "$*"
  echo "$*" > "$report" 2> /dev/null || true
}

state="$(timeout 120 systemctl is-system-running --wait 2>&1)"
say "BOOT-REPORT state=${state}"
say "BOOT-REPORT kernel=$(uname -r)"
say "BOOT-REPORT os=$(. /etc/os-release && echo "${PRETTY_NAME}")"
say "BOOT-REPORT init=$(readlink -f /sbin/init)"
say "BOOT-REPORT root=$(findmnt -n -o SOURCE,FSTYPE /)"
say "BOOT-REPORT mem_total_mb=$(awk '/MemTotal/ {print int($2 / 1024)}' /proc/meminfo)"
say "BOOT-REPORT mem_used_mb=$(free -m | awk '/Mem:/ {print $3}')"
say "BOOT-REPORT processes=$(ps -e --no-headers | wc -l)"
say "BOOT-REPORT failed_units=$(systemctl --failed --no-legend --plain | awk '{print $1}' | paste -sd, -)"
say "BOOT-REPORT $(systemd-analyze time 2>&1 | head -n 1)"
say "MINIMAL-ROOFS-BOOT-OK"
sync
# Give the serial port a moment to drain before the machine goes away.
sleep 1
systemctl poweroff
